From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eden Emulator Project <eden@example.invalid>
Date: Mon, 3 Aug 2026 12:00:00 +0800
Subject: [PATCH] support separate write and execute addresses

Keep CodeArray's public code address anchored to the executable mapping while
allowing an allocator to provide a distinct writable alias for emitted bytes.
The default allocator behavior remains unchanged.
---
 xbyak/xbyak.h | 25 ++++++++++++++++++++++---
 1 file changed, 22 insertions(+), 3 deletions(-)

diff --git a/xbyak/xbyak.h b/xbyak/xbyak.h
index c4cc0ad..74d0ec4 100644
--- a/xbyak/xbyak.h
+++ b/xbyak/xbyak.h
@@ -462,6 +462,7 @@ struct Allocator {
 	explicit Allocator(const std::string& = "") {} // same interface with MmapAllocator
 	virtual uint8_t *alloc(size_t size) { return reinterpret_cast<uint8_t*>(AlignedMalloc(size, inner::getPageSize())); }
 	virtual void free(uint8_t *p) { AlignedFree(p); }
+	virtual uint8_t *getWritableAddress(uint8_t *executable) const { return executable; }
 	virtual ~Allocator() {}
 	/* override to return false if you call protect() manually */
 	virtual bool useProtect() const { return true; }
@@ -1184,5 +1185,6 @@ protected:
 	size_t maxSize_;
 	uint8_t *top_;
+	uint8_t *writeTop_;
 	size_t size_;
 	bool isCalledCalcJmpAddress_;
 
@@ -1195,10 +1197,16 @@ protected:
 	{
 		const size_t newSize = (std::max<size_t>)(DEFAULT_MAX_CODE_SIZE, maxSize_ * 2);
 		uint8_t *newTop = alloc_->alloc(newSize);
 		if (newTop == 0) XBYAK_THROW(ERR_CANT_ALLOC)
-		for (size_t i = 0; i < size_; i++) newTop[i] = top_[i];
+		uint8_t *newWriteTop = alloc_->getWritableAddress(newTop);
+		if (newWriteTop == 0) {
+			alloc_->free(newTop);
+			XBYAK_THROW(ERR_CANT_ALLOC)
+		}
+		for (size_t i = 0; i < size_; i++) newWriteTop[i] = writeTop_[i];
 		alloc_->free(top_);
 		top_ = newTop;
+		writeTop_ = newWriteTop;
 		maxSize_ = newSize;
 	}
 	/*
@@ -1224,10 +1232,15 @@ public:
 		, alloc_(allocator ? allocator : (Allocator*)&defaultAllocator_)
 		, maxSize_(maxSize)
 		, top_(type_ == USER_BUF ? reinterpret_cast<uint8_t*>(userPtr) : alloc_->alloc((std::max<size_t>)(maxSize, 1)))
+		, writeTop_(top_ == 0 || type_ == USER_BUF ? top_ : alloc_->getWritableAddress(top_))
 		, size_(0)
 		, isCalledCalcJmpAddress_(false)
 	{
 		if (maxSize_ > 0 && top_ == 0) XBYAK_THROW(ERR_CANT_ALLOC)
+		if (top_ != 0 && writeTop_ == 0) {
+			if (isAllocType()) alloc_->free(top_);
+			XBYAK_THROW(ERR_CANT_ALLOC)
+		}
 		if ((type_ == ALLOC_BUF && userPtr != DontSetProtectRWE && useProtect()) && !setProtectMode(PROTECT_RWE, false)) {
 			alloc_->free(top_);
 			XBYAK_THROW(ERR_CANT_PROTECT)
@@ -1264,7 +1278,7 @@ public:
 				XBYAK_THROW(ERR_CODE_IS_TOO_BIG)
 			}
 		}
-		top_[size_++] = static_cast<uint8_t>(code);
+		writeTop_[size_++] = static_cast<uint8_t>(code);
 	}
 	void db(const uint8_t *code, size_t codeSize)
 	{
@@ -1284,6 +1298,13 @@ public:
 	const uint8_t *getCurr() const { return &top_[size_]; }
 	template<class F>
 	const F getCurr() const { return reinterpret_cast<F>(&top_[size_]); }
+	uint8_t *getWritableAddress(const void *executable) const
+	{
+		const uintptr_t base = reinterpret_cast<uintptr_t>(top_);
+		const uintptr_t address = reinterpret_cast<uintptr_t>(executable);
+		if (address < base || address - base > maxSize_) XBYAK_THROW_RET(ERR_OFFSET_IS_TOO_BIG, 0)
+		return writeTop_ + (address - base);
+	}
 	size_t getSize() const { return size_; }
 	void setSize(size_t size)
 	{
@@ -1321,7 +1342,7 @@ public:
 	{
 		assert(offset < maxSize_);
 		if (size != 1 && size != 2 && size != 4 && size != 8) XBYAK_THROW(ERR_BAD_PARAMETER)
-		uint8_t *const data = top_ + offset;
+		uint8_t *const data = writeTop_ + offset;
 		for (size_t i = 0; i < size; i++) {
 			data[i] = static_cast<uint8_t>(disp >> (i * 8));
 		}
-- 
2.39.5
